{
  "name": "discord-activity-starter",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "node server/server.js",
    "dev:bot": "node bot/bot.js",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:bot\"",
    "build": "vite build",
    "start": "node server/server.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^1.1.0",
    "cors": "^2.8.5",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
